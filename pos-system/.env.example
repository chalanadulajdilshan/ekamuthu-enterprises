APP_NAME="Ekamuthu POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo
# Full URL of this folder, no trailing slash
APP_URL=https://ekamuthu-enterprises.sourcecode.lk/pos-system

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Same database as the main Ekamuthu system. Every POS table is prefixed "pos_",
# so nothing in the main system's tables is touched.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=pos_

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_COOKIE=ekamuthu_pos_session
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# First admin login created by "php artisan db:seed --force" (random password if empty)
POS_ADMIN_EMAIL=admin@pos.local
POS_ADMIN_PASSWORD=

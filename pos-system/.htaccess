# Ekamuthu POS (Laravel) lives in /pos-system. Send EVERY request into public/
# so app code, .env, storage and vendor are never reachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
